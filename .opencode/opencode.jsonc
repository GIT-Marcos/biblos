{
  "$schema": "https://opencode.ai/config.json",
  "agent": {
    "biblos-planner": {
      "mode": "primary",
      "description": "Planificador general backend y frontend — planificación estructurada orientada para todo el sistema de Biblos",
      "prompt": "{file:./biblos-planner.md}",
      "permission": {
        "task": {
          "*": "allow"
        },
        "edit": "deny",
        "bash": "ask",
        "question": "allow"
      }
    }
  },
  "references": {
    "agent": {
      "path": "../agent",
      "description": "Módulo Agent — monitoreo de filesystem y sincronización"
    },
    "front": {
      "path": "../frontend",
      "description": "Módulo Frontend — interfaz de usuario React"
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      }
    }
  }
}
